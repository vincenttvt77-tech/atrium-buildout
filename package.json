{
  "name": "atrium",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\" \"api/**/*.test.ts\"",
    "test:watch": "node --test --watch \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/build-api.mjs",
    "validate": "node scripts/validate-data.mjs",
    "build:ops": "node scripts/build-ops.mjs",
    "build:site": "node scripts/build-site.mjs",
    "dev:ops": "node scripts/dev-ops.mjs",
    "simulate": "node scripts/simulate-calls.mjs",
    "build": "node scripts/build-site.mjs && node scripts/build-api.mjs",
    "check": "npm run typecheck && npm run validate && npm test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
