{
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Atrium — Operations</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#14161a; --paper:#fbfaf8; --panel:#fff; --line:#e6e3de;\n    --muted:#6b6862; --accent:#2f5d50; --warn:#8a5a1a; --danger:#9b2c2c; --ok:#2f5d50;\n  }\n  @media (prefers-color-scheme:dark){\n    :root{--ink:#eceae6;--paper:#101114;--panel:#181a1e;--line:#2a2d33;--muted:#9a968e;\n          --accent:#7fb3a2;--warn:#d8a45c;--danger:#e08585;--ok:#7fb3a2}\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--paper);color:var(--ink);\n       font:15px/1.55 Inter,system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}\n  .wrap{max-width:1180px;margin:0 auto;padding:32px 24px 80px}\n  header{display:flex;align-items:baseline;justify-content:space-between;gap:16px;\n         flex-wrap:wrap;margin-bottom:8px}\n  h1{font-size:22px;font-weight:600;letter-spacing:-.02em;margin:0}\n  .sub{color:var(--muted);font-size:13.5px;margin:4px 0 28px}\n  .live{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted)}\n  .dot{width:7px;height:7px;border-radius:50%;background:var(--ok);\n       box-shadow:0 0 0 0 rgba(47,93,80,.5);animation:p 2s infinite}\n  @keyframes p{70%{box-shadow:0 0 0 7px rgba(47,93,80,0)}100%{box-shadow:0 0 0 0 rgba(47,93,80,0)}}\n  .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:12px;margin-bottom:32px}\n  .tile{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:15px 16px}\n  .tile .n{font-size:26px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}\n  .tile .l{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-top:3px}\n  h2{font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);\n     font-weight:600;margin:0 0 12px;padding-bottom:9px;border-bottom:1px solid var(--line)}\n  .call{background:var(--panel);border:1px solid var(--line);border-radius:10px;\n        margin-bottom:14px;overflow:hidden}\n  .call-h{padding:13px 16px;border-bottom:1px solid var(--line);display:flex;\n          justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}\n  .call-id{font:500 12.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted)}\n  .ev{display:grid;grid-template-columns:74px 1fr;gap:14px;padding:11px 16px;\n      border-bottom:1px solid var(--line);font-size:13.5px;align-items:start}\n  .ev:last-child{border-bottom:0}\n  .t{font:400 11.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted);padding-top:2px}\n  .k{display:inline-block;font-size:10.5px;font-weight:600;text-transform:uppercase;\n     letter-spacing:.06em;padding:2.5px 7px;border-radius:4px;margin-bottom:5px;\n     background:rgba(120,120,120,.13);color:var(--muted)}\n  .k.ok{background:rgba(47,93,80,.14);color:var(--ok)}\n  .k.warn{background:rgba(138,90,26,.16);color:var(--warn)}\n  .k.danger{background:rgba(155,44,44,.15);color:var(--danger)}\n  .body{white-space:pre-wrap;word-break:break-word}\n  .ex{border-left:2px solid var(--line);padding:2px 0 2px 11px;margin-top:6px;\n      color:var(--muted);font-style:italic}\n  .meta{font:400 11.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted);margin-top:5px}\n  .empty{background:var(--panel);border:1px dashed var(--line);border-radius:10px;\n         padding:44px 24px;text-align:center;color:var(--muted)}\n  .empty strong{display:block;color:var(--ink);font-weight:600;margin-bottom:6px;font-size:15px}\n  .tel{font:600 15px Inter,sans-serif;color:var(--accent);text-decoration:none}\n  .note{font-size:12.5px;color:var(--muted);margin-top:36px;padding-top:16px;\n        border-top:1px solid var(--line)}\n  .privacy{font-size:12.5px;color:var(--muted);margin:-20px 0 28px}\n  .privacy b{color:var(--ink);font-weight:600}\n  .signout{font:inherit;font-size:12.5px;color:var(--muted);background:none;\n           border:1px solid var(--line);border-radius:5px;padding:3px 9px;cursor:pointer}\n  .signout:hover{color:var(--ink);border-color:var(--muted)}\n  @media(max-width:600px){.ev{grid-template-columns:1fr;gap:4px}.t{padding-top:0}}\n\n  .vcall{background:var(--panel);border:1px solid var(--line);border-radius:10px;\n         margin-bottom:14px;overflow:hidden}\n  .vcall-h{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;\n           justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline}\n  .vcall-who{font-weight:600}\n  .vcall-meta{font:400 11.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted)}\n  .tc{padding:9px 16px;border-bottom:1px solid var(--line);font-size:13px}\n  .tc:last-child{border-bottom:0}\n  .tc-name{font:500 12px JetBrains Mono,ui-monospace,monospace;color:var(--accent)}\n  .tc-args{color:var(--muted);font-size:12.5px;margin:3px 0}\n  .tc-res{white-space:pre-wrap;word-break:break-word;border-left:2px solid var(--line);\n          padding-left:10px;margin-top:4px;color:var(--ink)}\n  .tc-none{color:var(--danger);font-style:italic}\n  .tx{padding:11px 16px;white-space:pre-wrap;font-size:13px;line-height:1.55;\n      border-top:1px solid var(--line);max-height:280px;overflow:auto}\n  .tx summary{cursor:pointer;color:var(--muted);font-size:12.5px;padding:9px 16px}\n\n  .cal{background:var(--panel);border:1px solid var(--line);border-radius:10px;\n       margin-bottom:32px;overflow:hidden}\n  .cal-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;\n           flex-wrap:wrap;padding:11px 16px;border-bottom:1px solid var(--line)}\n  .cal-nav{display:inline-flex;align-items:center;gap:8px}\n  .cal-actions{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap}\n  .cal-range{font:500 12.5px JetBrains Mono,ui-monospace,monospace;min-width:190px;text-align:center}\n  .cal-btn{font:inherit;font-size:12.5px;color:var(--muted);background:none;\n           border:1px solid var(--line);border-radius:5px;padding:3px 9px;cursor:pointer}\n  .cal-btn:hover:not(:disabled){color:var(--ink);border-color:var(--muted)}\n  .cal-btn:disabled{opacity:.45;cursor:default}\n  .cal-btn.danger{color:var(--danger)}\n  .cal-btn.danger:hover:not(:disabled){color:var(--danger);border-color:var(--danger)}\n  .cal-tag{font-size:9.5px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;\n           padding:1px 5px;border-radius:3px;margin-left:5px;\n           background:rgba(138,90,26,.16);color:var(--warn)}\n  .warn-banner{margin:12px 16px 0;padding:10px 14px;border-radius:8px;font-size:13px;\n               background:rgba(138,90,26,.16);color:var(--warn);border:1px solid rgba(138,90,26,.28)}\n  .warn-banner b{font-weight:600}\n  .cal-scroll{overflow-x:auto}\n  .cal-grid{display:grid;grid-template-columns:62px repeat(7,minmax(108px,1fr));\n            grid-template-rows:auto;grid-auto-rows:24px;gap:2px;padding:12px;min-width:860px}\n  .cal-day,.cal-s{font:inherit;color:inherit;background:none;margin:0;width:100%;display:block;\n                  appearance:none;-webkit-appearance:none}\n  .cal-day:focus-visible,.cal-s:focus-visible{outline:2px solid var(--accent);outline-offset:1px}\n  .cal-day{grid-row:1;padding:6px 4px;border:1px solid var(--line);border-radius:6px;\n           text-align:center;font-size:12.5px;line-height:1.3;cursor:pointer;user-select:none}\n  .cal-day:hover{border-color:var(--muted)}\n  .cal-day.today .cal-dn{color:var(--accent)}\n  .cal-day.blocked{background:rgba(155,44,44,.15);border-color:transparent;color:var(--danger)}\n  .cal-day.blocked .cal-dd,.cal-day.blocked .cal-dc{color:var(--danger)}\n  .cal-dn{display:block;font-weight:600}\n  .cal-dd,.cal-dc{display:block;font:400 11px JetBrains Mono,ui-monospace,monospace;color:var(--muted)}\n  .cal-t{grid-column:1;font:400 11px JetBrains Mono,ui-monospace,monospace;color:var(--muted);\n         text-align:right;padding-right:8px;line-height:24px;white-space:nowrap}\n  .cal-s{border:1px solid var(--line);border-radius:4px;padding:0 7px;font-size:11.5px;text-align:left;\n         line-height:22px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer}\n  .cal-s.open{background:var(--paper)}\n  .cal-s.open:hover{border-color:var(--accent)}\n  .cal-s.blocked{background:rgba(155,44,44,.15);border-color:transparent;color:var(--danger)}\n  .cal-s.booked{background:rgba(47,93,80,.14);border-color:transparent;color:var(--ok);\n                font-weight:500;cursor:default}\n  .cal-empty{padding:0 16px 12px;color:var(--muted);font-size:13px}\n  .cal-empty:empty{display:none}\n  .cal-foot{display:flex;justify-content:space-between;align-items:center;gap:8px 18px;\n            flex-wrap:wrap;padding:10px 16px;border-top:1px solid var(--line);\n            font:400 11.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted)}\n  .cal-legend{display:inline-flex;gap:14px}\n  .cal-legend i{display:inline-block;width:11px;height:11px;border-radius:3px;\n                border:1px solid var(--line);background:var(--paper);vertical-align:-1px;margin-right:5px}\n  .cal-legend i.blocked{background:rgba(155,44,44,.15);border-color:transparent}\n  .cal-legend i.booked{background:rgba(47,93,80,.14);border-color:transparent}\n  .cal-hint,.cal-msg{font:400 12.5px Inter,system-ui,sans-serif}\n  .cal-msg.err{color:var(--danger)}\n  .cal-msg:empty{display:none}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div>\n      <h1>Operations</h1>\n      <div class=\"sub\">Every call, what was extracted, and what the agent did about it.</div>\n    </div>\n    <div class=\"live\"><span class=\"dot\"></span><span id=\"status\">Live · refreshing every 5s</span>\n      <button type=\"button\" class=\"signout\" id=\"signout\">Sign out</button></div>\n  </header>\n\n  <div class=\"privacy\"><b>Staff only.</b> This page carries prospect names, email addresses\n    and verbatim call excerpts. Do not screenshot it into a shared channel, and sign out\n    when you are done.</div>\n\n  <div class=\"tiles\" id=\"tiles\"></div>\n\n  <h2>Tour calendar</h2>\n  <div class=\"cal\">\n    <div class=\"cal-bar\">\n      <div class=\"cal-nav\">\n        <button type=\"button\" class=\"cal-btn\" id=\"cal-prev\">&lsaquo; Prev</button>\n        <span class=\"cal-range\" id=\"cal-range\">Loading…</span>\n        <button type=\"button\" class=\"cal-btn\" id=\"cal-next\">Next &rsaquo;</button>\n      </div>\n      <div class=\"cal-actions\">\n        <button type=\"button\" class=\"cal-btn danger\" id=\"cal-block-week\"\n          title=\"Blocks every day shown in this week, so a caller asking for a time is told there is nothing.\">Block everything this week</button>\n        <button type=\"button\" class=\"cal-btn\" id=\"cal-clear-blocks\"\n          title=\"Removes every block. The agent offers all of these times again.\">Clear all blocks</button>\n        <button type=\"button\" class=\"cal-btn\" id=\"cal-clear-bookings\"\n          title=\"Test control. Deletes every booking in the calendar store so a demo can be re-run. Not for real tours.\">Clear test bookings <span class=\"cal-tag\">test control</span></button>\n      </div>\n    </div>\n    <div id=\"cal-banner\"></div>\n    <div class=\"cal-scroll\"><div class=\"cal-grid\" id=\"cal-grid\"></div></div>\n    <div class=\"cal-empty\" id=\"cal-empty\"></div>\n    <div class=\"cal-foot\">\n      <span class=\"cal-legend\">\n        <span><i class=\"open\"></i>open</span><span><i class=\"blocked\"></i>blocked</span><span><i class=\"booked\"></i>booked</span>\n      </span>\n      <span class=\"cal-hint\">Click a slot — or Tab to it and press Enter — to block or unblock it; a day header does the whole day. Times are New York.</span>\n      <span class=\"cal-msg\" id=\"cal-msg\"></span>\n      <span id=\"cal-store\">Loading…</span>\n    </div>\n  </div>\n\n  <h2>Calls</h2>\n  <div id=\"calls-vapi\"></div>\n\n  <h2>Call activity</h2>\n  <div id=\"calls\"></div>\n\n  <div class=\"note\" id=\"note\"></div>\n</div>\n\n<script>\nconst KIND_STYLE = {\n  emergency:'danger', escalated:'danger', question_refused:'warn',\n  tour_booked:'ok', availability_checked:'', signal_captured:'ok',\n  question_answered:'', loss_reason:'warn', quote_gate:'warn', error:'danger',\n}\nconst LABEL = {\n  signal_captured:'captured', quote_gate:'quote gate', availability_checked:'availability',\n  question_answered:'answered', question_refused:'refused', tour_booked:'tour',\n  escalated:'escalated', emergency:'emergency', loss_reason:'loss reason',\n  slots_listed:'slots', call_status:'call', error:'error',\n}\nconst money = n => '$' + Number(n).toLocaleString('en-US')\n\nfunction describe(e){\n  switch(e.kind){\n    case 'signal_captured':\n      return {body:`${e.signal} = ${e.value}`, excerpt:e.excerpt,\n              meta:`confidence ${Math.round((e.confidence??0)*100)}%`}\n    case 'quote_gate':\n      return {body: e.allowed ? 'Cleared to quote'\n        : `Blocked — has ${(e.captured||[]).join(', ')||'nothing'}, still needs ${(e.missing||[]).join(', ')}`}\n    case 'availability_checked':\n      if(e.outcome==='priced_out') return {\n        body:`Priced out — ceiling ${money(e.budgetMax)}, cheapest available ${money(e.cheapestAvailable)}`,\n        meta:`gap ${money(e.gap)} · this is the countable loss reason`}\n      if(e.outcome==='matches') return {body:`Offered ${(e.unitsOffered||[]).join(', ')}`}\n      return {body:`No match — ${e.outcome}`}\n    case 'question_answered':\n      return {body:`\"${e.question}\" → ${e.decision}`,\n              meta:(e.sources&&e.sources.length)?`sources ${e.sources.join(', ')}`:`topic ${e.topic}`}\n    case 'question_refused':\n      return {body:`\"${e.question}\" → refused, did not guess`,\n              meta:`${e.reason} · asked ${e.timesAsked||1}×`}\n    case 'tour_booked':\n      return {body:`${e.status.toUpperCase()} — ${e.slot}${e.unitId?` · unit ${e.unitId}`:''}`,\n              meta:[e.prospectName,e.prospectEmail].filter(Boolean).join(' · ')}\n    case 'escalated': return {body:`${e.trigger}`, meta:e.detail||''}\n    case 'emergency': return {body:`${e.emergencyKind} detected`, excerpt:e.matched}\n    case 'loss_reason':\n      return {body:`${e.reason?.kind} — ${e.reason?.detail}`, excerpt:e.reason?.evidence}\n    case 'slots_listed': return {body:`${e.count} tour times offered`}\n    case 'call_status': return {body:e.status}\n    case 'error': return {body:e.message}\n    default: return {body:JSON.stringify(e)}\n  }\n}\n\nfunction renderCalls(d){\n  const el = document.getElementById('calls-vapi')\n  if (!el) return\n  if (d.callsError) {\n    el.innerHTML = `<div class=\"empty\"><strong>Call history unavailable</strong>${escapeHtml(d.callsError)}\n      ${d.callsConfigured === false ? '<br>Set <code>VAPI_PRIVATE_KEY</code> in the Vercel project and redeploy.' : ''}</div>`\n    return\n  }\n  const calls = d.calls || []\n  if (!calls.length) {\n    el.innerHTML = `<div class=\"empty\"><strong>No calls yet</strong>\n      Call <a class=\"tel\" href=\"tel:+15169909252\">(516) 990-9252</a>.</div>`\n    return\n  }\n  el.innerHTML = calls.map(c => {\n    const when = c.startedAt ? new Date(c.startedAt).toLocaleString('en-US',\n      {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'\n    const tools = (c.toolCalls||[]).map(t => `<div class=\"tc\">\n        <span class=\"tc-name\">${escapeHtml(t.name)}</span>\n        <div class=\"tc-args\">${escapeHtml(JSON.stringify(t.arguments))}</div>\n        ${t.result\n          ? `<div class=\"tc-res\">${escapeHtml(String(t.result).slice(0,600))}</div>`\n          : `<div class=\"tc-none\">no result returned — this is what a hung call looks like</div>`}\n      </div>`).join('') || '<div class=\"tc tc-none\">No tools were called on this call.</div>'\n    return `<div class=\"vcall\">\n      <div class=\"vcall-h\">\n        <span class=\"vcall-who\">${escapeHtml(c.customerNumber || 'Unknown caller')}</span>\n        <span class=\"vcall-meta\">${when} · ${c.durationSeconds!=null?c.durationSeconds+'s':'—'} · ${escapeHtml(c.endedReason||'')}</span>\n      </div>\n      ${tools}\n      ${c.transcript ? `<details><summary>Transcript</summary><div class=\"tx\">${escapeHtml(c.transcript)}</div></details>` : ''}\n    </div>`\n  }).join('')\n}\n\nfunction render(data){\n  renderCalls(data)\n  const evs = data.events || []\n  const byCall = {}\n  for(const e of evs){ (byCall[e.callId] ||= []).push(e) }\n\n  const calls = Object.keys(byCall)\n  const booked = evs.filter(e=>e.kind==='tour_booked'&&e.status==='confirmed').length\n  const esc = evs.filter(e=>e.kind==='escalated').length\n  const refused = evs.filter(e=>e.kind==='question_refused').length\n  const pricedOut = evs.filter(e=>e.kind==='availability_checked'&&e.outcome==='priced_out')\n  const avgGap = pricedOut.length\n    ? Math.round(pricedOut.reduce((s,e)=>s+(e.gap||0),0)/pricedOut.length) : null\n\n  document.getElementById('tiles').innerHTML = [\n    [calls.length,'Calls'], [booked,'Tours booked'], [esc,'Escalations'],\n    [refused,'Refused to guess'], [pricedOut.length,'Priced out'],\n    [avgGap!==null?money(avgGap):'—','Avg gap'],\n  ].map(([n,l])=>`<div class=\"tile\"><div class=\"n\">${n}</div><div class=\"l\">${l}</div></div>`).join('')\n\n  const el = document.getElementById('calls')\n  if(calls.length===0){\n    el.innerHTML = `<div class=\"empty\"><strong>No calls yet</strong>\n      Call <a class=\"tel\" href=\"tel:+15169909252\">(516) 990-9252</a> and this fills in as it happens.</div>`\n    return\n  }\n\n  el.innerHTML = calls.reverse().map(id=>{\n    const rows = byCall[id].map(e=>{\n      const d = describe(e)\n      const t = new Date(e.at).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit'})\n      return `<div class=\"ev\"><div class=\"t\">${t}</div><div>\n        <span class=\"k ${KIND_STYLE[e.kind]||''}\">${LABEL[e.kind]||e.kind}</span>\n        <div class=\"body\">${escapeHtml(d.body||'')}</div>\n        ${d.excerpt?`<div class=\"ex\">\"${escapeHtml(d.excerpt)}\"</div>`:''}\n        ${d.meta?`<div class=\"meta\">${escapeHtml(d.meta)}</div>`:''}\n      </div></div>`\n    }).join('')\n    return `<div class=\"call\"><div class=\"call-h\">\n      <span class=\"call-id\">${escapeHtml(id)}</span>\n      <span class=\"call-id\">${byCall[id].length} events</span>\n    </div>${rows}</div>`\n  }).join('')\n}\n\nfunction escapeHtml(s){\n  return String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]))\n}\n\n/**\n * The tour calendar. Reads and writes /api/calendar, which sits behind the same session as\n * this page, so a 401 there means what a 401 on the log means: back to the gate.\n *\n * Every write re-renders from the state the server returns, never from what the click\n * assumed. A poll that lands while a write is in flight is dropped rather than painted, so\n * the grid cannot flash back to a state the owner has already changed. Times are shown in\n * America/New_York because that is where the building is; the browser's zone is ignored.\n */\nconst NY_TZ = 'America/New_York'\nconst nyFormat = new Intl.DateTimeFormat('en-US', {\n  timeZone:NY_TZ, hourCycle:'h23', year:'numeric', month:'2-digit', day:'2-digit',\n  hour:'2-digit', minute:'2-digit',\n})\nfunction nyParts(d){\n  const o = {}\n  for(const p of nyFormat.formatToParts(d)) o[p.type] = p.value\n  return o\n}\nconst nyDate = d => { const p = nyParts(d); return `${p.year}-${p.month}-${p.day}` }\nconst nyMinutes = d => { const p = nyParts(d); return (Number(p.hour) % 24) * 60 + Number(p.minute) }\nconst ymdToUtc = ymd => { const [y, m, d] = ymd.split('-').map(Number); return Date.UTC(y, m - 1, d, 12) }\nconst addDays = (ymd, n) => new Date(ymdToUtc(ymd) + n * 86400000).toISOString().slice(0, 10)\nconst daysBetween = (a, b) => Math.round((ymdToUtc(b) - ymdToUtc(a)) / 86400000)\nfunction dayLabel(ymd){\n  const t = new Date(ymdToUtc(ymd))\n  return {\n    dn: t.toLocaleDateString('en-US', {weekday:'short', timeZone:'UTC'}),\n    dd: t.toLocaleDateString('en-US', {month:'short', day:'numeric', timeZone:'UTC'}),\n  }\n}\nconst fmtTime = mins => {\n  const h = Math.floor(mins / 60) % 24, m = mins % 60\n  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')}${h < 12 ? 'a' : 'p'}`\n}\nconst isDate = t => /^\\d{4}-\\d{2}-\\d{2}$/.test(String(t))\nconst cssq = s => (window.CSS && CSS.escape) ? CSS.escape(String(s)) : String(s).replace(/[\"\\\\]/g, '\\\\$&')\n\nconst cal = { state:null, key:'', page:0, busy:false, seq:0, pollError:false }\n\n/** Where the visible window starts, how many pages it needs, and the union of business hours. */\nfunction calLayout(state){\n  const slots = state.slots || []\n  const today = nyDate(new Date())\n  let start = today, end = today\n  for(const s of slots){ if(s.date < start) start = s.date; if(s.date > end) end = s.date }\n  const pages = Math.max(2, Math.ceil((daysBetween(start, end) + 1) / 7))\n  let minM = Infinity, maxM = -Infinity\n  for(const s of slots){\n    const a = new Date(s.startsAt), b = new Date(s.endsAt)\n    const t0 = nyMinutes(a), t1 = t0 + Math.round((b - a) / 60000)\n    if(t0 < minM) minM = t0\n    if(t1 > maxM) maxM = t1\n  }\n  if(!(minM < maxM)){ minM = 10 * 60; maxM = 19 * 60 }\n  return { today, start, end, pages, minM, maxM }\n}\nfunction visibleDays(L){\n  const out = []\n  for(let i = 0; i < 7; i++) out.push(addDays(L.start, cal.page * 7 + i))\n  return out\n}\n\nfunction calMessage(text, isError){\n  const el = document.getElementById('cal-msg')\n  el.textContent = text || ''\n  el.classList.toggle('err', !!isError)\n}\n\nfunction renderCalendar(){\n  const state = cal.state\n  if(!state) return\n  const L = calLayout(state)\n  cal.page = Math.min(Math.max(cal.page, 0), L.pages - 1)\n  const days = visibleDays(L)\n  const first = dayLabel(days[0]), last = dayLabel(days[6])\n  document.getElementById('cal-range').textContent =\n    `Week ${cal.page + 1} of ${L.pages} · ${first.dd} – ${last.dd}`\n  document.getElementById('cal-prev').disabled = cal.page === 0\n  document.getElementById('cal-next').disabled = cal.page >= L.pages - 1\n\n  const store = state.store || {}\n  const blocks = state.blocks || [], bookings = state.bookings || [], slots = state.slots || []\n  // A store that reports it could not be reached (`store.error`, if the API ever sends it)\n  // must not be painted as an empty calendar the owner then believes.\n  const storeError = store.error ? String(store.error) : ''\n  document.getElementById('cal-banner').innerHTML = store.durable === false\n    ? `<div class=\"warn-banner\"><b>Blocks will not persist.</b> ${escapeHtml(store.note || '')}</div>`\n    : storeError\n      ? `<div class=\"warn-banner\"><b>The calendar store is not answering.</b> This is probably an empty calendar rather than the real one; wait for it to recover before changing anything. ${escapeHtml(storeError)}</div>`\n      : ''\n  // Blocks on slots that have passed, or on ids the calendar no longer generates, are\n  // invisible on the grid but still counted — say so, so \"3 blocks\" over an empty grid is\n  // not a mystery. \"Clear all blocks\" removes them.\n  const shownSlots = new Set(slots.map(s => s.slotId))\n  const unseen = blocks.filter(b => isDate(b.target)\n    ? (b.target < L.today || b.target > L.end) : !shownSlots.has(b.target)).length\n  document.getElementById('cal-store').textContent =\n    `store ${store.kind || '?'} · ${storeError ? 'unreachable' : store.durable ? 'durable' : 'not durable'} · ` +\n    `${blocks.length} block${blocks.length === 1 ? '' : 's'}${unseen ? ` (${unseen} on times not shown)` : ''} · ` +\n    `${bookings.length} booking${bookings.length === 1 ? '' : 's'}`\n\n  const dayBlocks = new Map(), slotBlocks = new Map()\n  for(const b of blocks){\n    const m = isDate(b.target) ? dayBlocks : slotBlocks\n    if(!m.has(b.target)) m.set(b.target, b)\n  }\n  const countByDay = {}, openByDay = {}\n  for(const s of slots){\n    countByDay[s.date] = (countByDay[s.date] || 0) + 1\n    if(s.status === 'open') openByDay[s.date] = (openByDay[s.date] || 0) + 1\n  }\n\n  // Day headers and open/blocked slots are real buttons: Tab reaches them, Enter and Space\n  // activate them through the same delegated click handler, and a screen reader gets the\n  // title as the name (an open slot has no visible text). Booked cells are not controls.\n  let html = ''\n  days.forEach((d, i) => {\n    const lab = dayLabel(d), blk = dayBlocks.get(d)\n    const count = blk ? 'day blocked' : countByDay[d] ? `${openByDay[d] || 0} open` : 'no slots'\n    const title = blk\n      ? `${lab.dn} ${lab.dd} — whole day blocked: ${blk.reason || 'blocked'}. Unblock the day.`\n      : `${lab.dn} ${lab.dd} — ${count}. Block the whole day.`\n    html += `<button type=\"button\" class=\"cal-day${blk ? ' blocked' : ''}${d === L.today ? ' today' : ''}\"\n      style=\"grid-column:${i + 2}\" data-date=\"${escapeHtml(d)}\" aria-pressed=\"${blk ? 'true' : 'false'}\"\n      title=\"${escapeHtml(title)}\" aria-label=\"${escapeHtml(title)}\">\n      <span class=\"cal-dn\">${escapeHtml(lab.dn)}</span><span class=\"cal-dd\">${escapeHtml(lab.dd)}</span>\n      <span class=\"cal-dc\">${escapeHtml(count)}</span></button>`\n  })\n\n  const rows = Math.ceil((L.maxM - L.minM) / 30)\n  for(let r = 0; r < rows; r++)\n    html += `<div class=\"cal-t\" style=\"grid-row:${r + 2}\">${escapeHtml(fmtTime(L.minM + r * 30))}</div>`\n\n  for(const s of slots){\n    const col = days.indexOf(s.date)\n    if(col < 0) continue\n    const a = new Date(s.startsAt), b = new Date(s.endsAt)\n    const t0 = nyMinutes(a), t1 = t0 + Math.round((b - a) / 60000)\n    const row = Math.round((t0 - L.minM) / 30)\n    if(row < 0 || row >= rows) continue\n    const lab = dayLabel(s.date)\n    const when = `${lab.dn} ${lab.dd}, ${fmtTime(t0)}–${fmtTime(t1)}`\n    const pos = `grid-column:${col + 2};grid-row:${row + 2}`\n    if(s.status === 'booked'){\n      const who = (s.booking && s.booking.prospectName) || 'booked'\n      const unit = s.booking && s.booking.unitId\n      const title = `${when} · booked — ${who}${unit ? `, unit ${unit}` : ''}`\n      html += `<div class=\"cal-s booked\" style=\"${pos}\" data-slot=\"${escapeHtml(s.slotId)}\"\n        title=\"${escapeHtml(title)}\" aria-label=\"${escapeHtml(title)}\">${escapeHtml(unit ? `${who} · ${unit}` : who)}</div>`\n      continue\n    }\n    // A slot under both its own block and a day block shows its own, so unblocking it\n    // removes that and leaves the day block in plain view — rather than a click that removes\n    // the day block and leaves the cell red. The blocks list decides; s.block is the fallback.\n    const own = slotBlocks.get(s.slotId), dayBlk = dayBlocks.get(s.date)\n    const whole = own ? false : dayBlk ? true : !!(s.block && s.block.wholeDay)\n    const reason = (own || dayBlk || s.block || {}).reason || 'blocked'\n    const blocked = s.status === 'blocked'\n    const title = blocked\n      ? `${when} · blocked${whole ? ' (whole day)' : ''} — ${reason}. Unblock${whole ? ' the day' : ''}.`\n      : `${when} · open. Block this slot.`\n    html += `<button type=\"button\" class=\"cal-s ${escapeHtml(s.status)}\" style=\"${pos}\"\n      data-slot=\"${escapeHtml(s.slotId)}\" data-date=\"${escapeHtml(s.date)}\" data-status=\"${escapeHtml(s.status)}\"\n      data-whole=\"${whole ? '1' : ''}\" data-when=\"${escapeHtml(when)}\" aria-pressed=\"${blocked ? 'true' : 'false'}\"\n      title=\"${escapeHtml(title)}\" aria-label=\"${escapeHtml(title)}\">${escapeHtml(blocked ? reason : '')}</button>`\n  }\n\n  // Replacing the grid's HTML would drop a keyboard user's focus to the page body; put it\n  // back on the same cell afterwards, where one still exists.\n  const grid = document.getElementById('cal-grid')\n  const active = document.activeElement\n  const keep = active && grid.contains(active) && active.dataset\n    ? (active.dataset.slot ? `.cal-s[data-slot=\"${cssq(active.dataset.slot)}\"]`\n      : active.dataset.date ? `.cal-day[data-date=\"${cssq(active.dataset.date)}\"]` : null)\n    : null\n  grid.innerHTML = html\n  if(keep){ const el = grid.querySelector(keep); if(el) el.focus({preventScroll:true}) }\n  document.getElementById('cal-empty').textContent = slots.length\n    ? '' : 'No tour slots in the window — everything is inside the notice period or outside business hours.'\n}\n\nasync function calPost(body){\n  const r = await fetch('/api/calendar', {\n    method:'POST', credentials:'same-origin', cache:'no-store',\n    headers:{'content-type':'application/json', accept:'application/json'},\n    body:JSON.stringify(body),\n  })\n  if(r.status === 401 || r.status === 403){ toGate(); throw new Error('Signed out') }\n  const d = await r.json().catch(() => ({}))\n  if(!r.ok) throw new Error(d.error || ('HTTP ' + r.status))\n  return d\n}\n\nfunction applyCalendarState(d){\n  cal.seq++ // any poll already in flight is stale now\n  cal.state = d\n  cal.key = JSON.stringify([d.slots, d.blocks, d.bookings, d.store])\n  renderCalendar()\n}\n\n/** Runs one owner action. `fn` does its own POSTs and returns the last state, or null to cancel. */\nasync function calAct(fn){\n  if(cal.busy) return\n  cal.busy = true\n  let failed = false\n  try{\n    const last = await fn()\n    if(last) applyCalendarState(last)\n    calMessage('')\n  }catch(err){\n    failed = true\n    calMessage(err && err.message ? err.message : String(err), true)\n  }finally{\n    cal.busy = false\n  }\n  // A write that failed may still have changed the store — a response lost in transit, or\n  // a multi-step action that stopped partway. Re-read now rather than show a stale grid\n  // under the error until the next poll. Not after a sign-out: polling has stopped.\n  if(failed && timer !== null) tickCalendar()\n}\n\nfunction askReason(msg){\n  const r = prompt(msg, 'blocked')\n  if(r === null) return null\n  return (r.trim() || 'blocked').slice(0, 120)\n}\n\nasync function tickCalendar(){\n  if(cal.busy) return\n  const seq = ++cal.seq\n  try{\n    const r = await fetch('/api/calendar', {\n      cache:'no-store', credentials:'same-origin', headers:{accept:'application/json'},\n    })\n    if(r.status === 401 || r.status === 403){ toGate(); return }\n    const d = await r.json().catch(() => ({}))\n    if(!r.ok) throw new Error(d.error || ('HTTP ' + r.status))\n    if(seq !== cal.seq || cal.busy) return // something newer landed meanwhile\n    if(cal.pollError){ cal.pollError = false; calMessage('') }\n    const key = JSON.stringify([d.slots, d.blocks, d.bookings, d.store])\n    if(key === cal.key) return\n    cal.state = d; cal.key = key\n    renderCalendar()\n  }catch(err){\n    cal.pollError = true\n    calMessage('Calendar unavailable — ' + (err && err.message ? err.message : err), true)\n  }\n}\n\ndocument.getElementById('cal-prev').addEventListener('click', () => { cal.page--; renderCalendar() })\ndocument.getElementById('cal-next').addEventListener('click', () => { cal.page++; renderCalendar() })\n\ndocument.getElementById('cal-grid').addEventListener('click', ev => {\n  if(!cal.state) return\n  const slot = ev.target.closest('.cal-s')\n  if(slot){\n    const { slot:slotId, date, status, whole, when } = slot.dataset\n    if(status === 'open'){\n      calAct(async () => {\n        const reason = askReason(`Block ${when}?\\nReason:`)\n        return reason === null ? null : calPost({action:'block', target:slotId, reason})\n      })\n    } else if(status === 'blocked'){\n      calAct(async () => {\n        if(whole){\n          if(!confirm(`${when} is blocked because the whole day is. Unblock the entire day?`)) return null\n          return calPost({action:'unblock', target:date})\n        }\n        return calPost({action:'unblock', target:slotId})\n      })\n    }\n    return // booked slots are not clickable\n  }\n  const day = ev.target.closest('.cal-day')\n  if(day){\n    const date = day.dataset.date\n    const lab = dayLabel(date)\n    const blocked = (cal.state.blocks || []).some(b => b.target === date)\n    calAct(async () => {\n      if(blocked){\n        return confirm(`Unblock the whole of ${lab.dn} ${lab.dd}?`)\n          ? calPost({action:'unblock', target:date}) : null\n      }\n      const reason = askReason(`Block the whole of ${lab.dn} ${lab.dd}?\\nReason:`)\n      return reason === null ? null : calPost({action:'block', target:date, reason})\n    })\n  }\n})\n\ndocument.getElementById('cal-block-week').addEventListener('click', () => {\n  if(!cal.state) return\n  const days = visibleDays(calLayout(cal.state))\n  calAct(async () => {\n    const reason = askReason(\n      `Block every day from ${dayLabel(days[0]).dd} to ${dayLabel(days[6]).dd}?\\nReason:`)\n    if(reason === null) return null\n    let last = null, current = null\n    try{\n      for(const d of days){\n        current = d\n        calMessage(`Blocking ${d}…`)\n        last = await calPost({action:'block', target:d, reason})\n      }\n    }catch(err){\n      // The days before this one are blocked in the store. Paint that state now, then\n      // report the failure — otherwise the grid shows them open until the next poll.\n      if(last) applyCalendarState(last)\n      const why = err && err.message ? err.message : String(err)\n      throw new Error(`Blocking ${dayLabel(current).dd} failed — ${why}. Earlier days in the week are blocked.`)\n    }\n    return last\n  })\n})\ndocument.getElementById('cal-clear-blocks').addEventListener('click', () => {\n  calAct(async () => confirm('Remove every block from the calendar? The agent will offer all of these times again.')\n    ? calPost({action:'clear_blocks'}) : null)\n})\ndocument.getElementById('cal-clear-bookings').addEventListener('click', () => {\n  calAct(async () => confirm(\n    'TEST CONTROL: this deletes every booking in the calendar store, including any real tour. ' +\n    'Only use it to reset between test calls. Continue?')\n    ? calPost({action:'clear_bookings'}) : null)\n})\n\n/**\n * The log endpoint is gated by the same operations session that served this page, so the\n * poll sends the session cookie and treats a 401 as \"the session ended\", not as a blip. A\n * dashboard that keeps retrying a closed door looks broken; sending the operator back to\n * the gate is honest and takes one click to fix.\n */\nlet timer = null\nfunction stopPolling(){ if(timer !== null){ clearInterval(timer); timer = null } }\nfunction toGate(){ stopPolling(); location.assign('/api/dashboard') }\n\nasync function tick(){\n  tickCalendar() // never throws; it reports its own failures in the calendar footer\n  try{\n    const r = await fetch('/api/vapi', {\n      cache:'no-store', credentials:'same-origin', headers:{accept:'application/json'},\n    })\n    if(r.status === 401 || r.status === 403){ toGate(); return }\n    if(!r.ok) throw new Error('HTTP ' + r.status)\n    const d = await r.json()\n    render(d)\n    document.getElementById('status').textContent =\n      'Live · updated ' + new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})\n    document.getElementById('note').textContent = d.note || ''\n  }catch(err){\n    document.getElementById('status').textContent = 'Reconnecting…'\n  }\n}\n\ndocument.getElementById('signout').addEventListener('click', async () => {\n  stopPolling()\n  try{\n    await fetch('/api/dashboard', {\n      method:'POST', credentials:'same-origin',\n      headers:{'content-type':'application/json'}, body:JSON.stringify({action:'logout'}),\n    })\n  }catch(err){ /* the cookie expires on its own; go back to the gate regardless */ }\n  location.assign('/api/dashboard')\n})\n\ntick(); timer = setInterval(tick, 5000)\n</script>\n</body>\n</html>\n"
}
