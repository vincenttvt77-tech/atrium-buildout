{
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Atrium — Operations</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#14161a; --paper:#fbfaf8; --panel:#fff; --line:#e6e3de;\n    --muted:#6b6862; --accent:#2f5d50; --warn:#8a5a1a; --danger:#9b2c2c; --ok:#2f5d50;\n  }\n  @media (prefers-color-scheme:dark){\n    :root{--ink:#eceae6;--paper:#101114;--panel:#181a1e;--line:#2a2d33;--muted:#9a968e;\n          --accent:#7fb3a2;--warn:#d8a45c;--danger:#e08585;--ok:#7fb3a2}\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--paper);color:var(--ink);\n       font:15px/1.55 Inter,system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased}\n  .wrap{max-width:1180px;margin:0 auto;padding:32px 24px 80px}\n  header{display:flex;align-items:baseline;justify-content:space-between;gap:16px;\n         flex-wrap:wrap;margin-bottom:8px}\n  h1{font-size:22px;font-weight:600;letter-spacing:-.02em;margin:0}\n  .sub{color:var(--muted);font-size:13.5px;margin:4px 0 28px}\n  .live{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:var(--muted)}\n  .dot{width:7px;height:7px;border-radius:50%;background:var(--ok);\n       box-shadow:0 0 0 0 rgba(47,93,80,.5);animation:p 2s infinite}\n  @keyframes p{70%{box-shadow:0 0 0 7px rgba(47,93,80,0)}100%{box-shadow:0 0 0 0 rgba(47,93,80,0)}}\n  .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:12px;margin-bottom:32px}\n  .tile{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:15px 16px}\n  .tile .n{font-size:26px;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}\n  .tile .l{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-top:3px}\n  h2{font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);\n     font-weight:600;margin:0 0 12px;padding-bottom:9px;border-bottom:1px solid var(--line)}\n  .call{background:var(--panel);border:1px solid var(--line);border-radius:10px;\n        margin-bottom:14px;overflow:hidden}\n  .call-h{padding:13px 16px;border-bottom:1px solid var(--line);display:flex;\n          justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}\n  .call-id{font:500 12.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted)}\n  .ev{display:grid;grid-template-columns:74px 1fr;gap:14px;padding:11px 16px;\n      border-bottom:1px solid var(--line);font-size:13.5px;align-items:start}\n  .ev:last-child{border-bottom:0}\n  .t{font:400 11.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted);padding-top:2px}\n  .k{display:inline-block;font-size:10.5px;font-weight:600;text-transform:uppercase;\n     letter-spacing:.06em;padding:2.5px 7px;border-radius:4px;margin-bottom:5px;\n     background:rgba(120,120,120,.13);color:var(--muted)}\n  .k.ok{background:rgba(47,93,80,.14);color:var(--ok)}\n  .k.warn{background:rgba(138,90,26,.16);color:var(--warn)}\n  .k.danger{background:rgba(155,44,44,.15);color:var(--danger)}\n  .body{white-space:pre-wrap;word-break:break-word}\n  .ex{border-left:2px solid var(--line);padding:2px 0 2px 11px;margin-top:6px;\n      color:var(--muted);font-style:italic}\n  .meta{font:400 11.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted);margin-top:5px}\n  .empty{background:var(--panel);border:1px dashed var(--line);border-radius:10px;\n         padding:44px 24px;text-align:center;color:var(--muted)}\n  .empty strong{display:block;color:var(--ink);font-weight:600;margin-bottom:6px;font-size:15px}\n  .tel{font:600 15px Inter,sans-serif;color:var(--accent);text-decoration:none}\n  .note{font-size:12.5px;color:var(--muted);margin-top:36px;padding-top:16px;\n        border-top:1px solid var(--line)}\n  .privacy{font-size:12.5px;color:var(--muted);margin:-20px 0 28px}\n  .privacy b{color:var(--ink);font-weight:600}\n  .signout{font:inherit;font-size:12.5px;color:var(--muted);background:none;\n           border:1px solid var(--line);border-radius:5px;padding:3px 9px;cursor:pointer}\n  .signout:hover{color:var(--ink);border-color:var(--muted)}\n  @media(max-width:600px){.ev{grid-template-columns:1fr;gap:4px}.t{padding-top:0}}\n\n  .vcall{background:var(--panel);border:1px solid var(--line);border-radius:10px;\n         margin-bottom:14px;overflow:hidden}\n  .vcall-h{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;\n           justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline}\n  .vcall-who{font-weight:600}\n  .vcall-meta{font:400 11.5px JetBrains Mono,ui-monospace,monospace;color:var(--muted)}\n  .tc{padding:9px 16px;border-bottom:1px solid var(--line);font-size:13px}\n  .tc:last-child{border-bottom:0}\n  .tc-name{font:500 12px JetBrains Mono,ui-monospace,monospace;color:var(--accent)}\n  .tc-args{color:var(--muted);font-size:12.5px;margin:3px 0}\n  .tc-res{white-space:pre-wrap;word-break:break-word;border-left:2px solid var(--line);\n          padding-left:10px;margin-top:4px;color:var(--ink)}\n  .tc-none{color:var(--danger);font-style:italic}\n  .tx{padding:11px 16px;white-space:pre-wrap;font-size:13px;line-height:1.55;\n      border-top:1px solid var(--line);max-height:280px;overflow:auto}\n  .tx summary{cursor:pointer;color:var(--muted);font-size:12.5px;padding:9px 16px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div>\n      <h1>Operations</h1>\n      <div class=\"sub\">Every call, what was extracted, and what the agent did about it.</div>\n    </div>\n    <div class=\"live\"><span class=\"dot\"></span><span id=\"status\">Live · refreshing every 5s</span>\n      <button type=\"button\" class=\"signout\" id=\"signout\">Sign out</button></div>\n  </header>\n\n  <div class=\"privacy\"><b>Staff only.</b> This page carries prospect names, email addresses\n    and verbatim call excerpts. Do not screenshot it into a shared channel, and sign out\n    when you are done.</div>\n\n  <div class=\"tiles\" id=\"tiles\"></div>\n  <h2>Calls</h2>\n  <div id=\"calls-vapi\"></div>\n\n  <h2>Call activity</h2>\n  <div id=\"calls\"></div>\n\n  <div class=\"note\" id=\"note\"></div>\n</div>\n\n<script>\nconst KIND_STYLE = {\n  emergency:'danger', escalated:'danger', question_refused:'warn',\n  tour_booked:'ok', availability_checked:'', signal_captured:'ok',\n  question_answered:'', loss_reason:'warn', quote_gate:'warn', error:'danger',\n}\nconst LABEL = {\n  signal_captured:'captured', quote_gate:'quote gate', availability_checked:'availability',\n  question_answered:'answered', question_refused:'refused', tour_booked:'tour',\n  escalated:'escalated', emergency:'emergency', loss_reason:'loss reason',\n  slots_listed:'slots', call_status:'call', error:'error',\n}\nconst money = n => '$' + Number(n).toLocaleString('en-US')\n\nfunction describe(e){\n  switch(e.kind){\n    case 'signal_captured':\n      return {body:`${e.signal} = ${e.value}`, excerpt:e.excerpt,\n              meta:`confidence ${Math.round((e.confidence??0)*100)}%`}\n    case 'quote_gate':\n      return {body: e.allowed ? 'Cleared to quote'\n        : `Blocked — has ${(e.captured||[]).join(', ')||'nothing'}, still needs ${(e.missing||[]).join(', ')}`}\n    case 'availability_checked':\n      if(e.outcome==='priced_out') return {\n        body:`Priced out — ceiling ${money(e.budgetMax)}, cheapest available ${money(e.cheapestAvailable)}`,\n        meta:`gap ${money(e.gap)} · this is the countable loss reason`}\n      if(e.outcome==='matches') return {body:`Offered ${(e.unitsOffered||[]).join(', ')}`}\n      return {body:`No match — ${e.outcome}`}\n    case 'question_answered':\n      return {body:`\"${e.question}\" → ${e.decision}`,\n              meta:(e.sources&&e.sources.length)?`sources ${e.sources.join(', ')}`:`topic ${e.topic}`}\n    case 'question_refused':\n      return {body:`\"${e.question}\" → refused, did not guess`,\n              meta:`${e.reason} · asked ${e.timesAsked||1}×`}\n    case 'tour_booked':\n      return {body:`${e.status.toUpperCase()} — ${e.slot}${e.unitId?` · unit ${e.unitId}`:''}`,\n              meta:[e.prospectName,e.prospectEmail].filter(Boolean).join(' · ')}\n    case 'escalated': return {body:`${e.trigger}`, meta:e.detail||''}\n    case 'emergency': return {body:`${e.emergencyKind} detected`, excerpt:e.matched}\n    case 'loss_reason':\n      return {body:`${e.reason?.kind} — ${e.reason?.detail}`, excerpt:e.reason?.evidence}\n    case 'slots_listed': return {body:`${e.count} tour times offered`}\n    case 'call_status': return {body:e.status}\n    case 'error': return {body:e.message}\n    default: return {body:JSON.stringify(e)}\n  }\n}\n\nfunction renderCalls(d){\n  const el = document.getElementById('calls-vapi')\n  if (!el) return\n  if (d.callsError) {\n    el.innerHTML = `<div class=\"empty\"><strong>Call history unavailable</strong>${escapeHtml(d.callsError)}\n      ${d.callsConfigured === false ? '<br>Set <code>VAPI_PRIVATE_KEY</code> in the Vercel project and redeploy.' : ''}</div>`\n    return\n  }\n  const calls = d.calls || []\n  if (!calls.length) {\n    el.innerHTML = `<div class=\"empty\"><strong>No calls yet</strong>\n      Call <a class=\"tel\" href=\"tel:+15169909252\">(516) 990-9252</a>.</div>`\n    return\n  }\n  el.innerHTML = calls.map(c => {\n    const when = c.startedAt ? new Date(c.startedAt).toLocaleString('en-US',\n      {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—'\n    const tools = (c.toolCalls||[]).map(t => `<div class=\"tc\">\n        <span class=\"tc-name\">${escapeHtml(t.name)}</span>\n        <div class=\"tc-args\">${escapeHtml(JSON.stringify(t.arguments))}</div>\n        ${t.result\n          ? `<div class=\"tc-res\">${escapeHtml(String(t.result).slice(0,600))}</div>`\n          : `<div class=\"tc-none\">no result returned — this is what a hung call looks like</div>`}\n      </div>`).join('') || '<div class=\"tc tc-none\">No tools were called on this call.</div>'\n    return `<div class=\"vcall\">\n      <div class=\"vcall-h\">\n        <span class=\"vcall-who\">${escapeHtml(c.customerNumber || 'Unknown caller')}</span>\n        <span class=\"vcall-meta\">${when} · ${c.durationSeconds!=null?c.durationSeconds+'s':'—'} · ${escapeHtml(c.endedReason||'')}</span>\n      </div>\n      ${tools}\n      ${c.transcript ? `<details><summary>Transcript</summary><div class=\"tx\">${escapeHtml(c.transcript)}</div></details>` : ''}\n    </div>`\n  }).join('')\n}\n\nfunction render(data){\n  renderCalls(data)\n  const evs = data.events || []\n  const byCall = {}\n  for(const e of evs){ (byCall[e.callId] ||= []).push(e) }\n\n  const calls = Object.keys(byCall)\n  const booked = evs.filter(e=>e.kind==='tour_booked'&&e.status==='confirmed').length\n  const esc = evs.filter(e=>e.kind==='escalated').length\n  const refused = evs.filter(e=>e.kind==='question_refused').length\n  const pricedOut = evs.filter(e=>e.kind==='availability_checked'&&e.outcome==='priced_out')\n  const avgGap = pricedOut.length\n    ? Math.round(pricedOut.reduce((s,e)=>s+(e.gap||0),0)/pricedOut.length) : null\n\n  document.getElementById('tiles').innerHTML = [\n    [calls.length,'Calls'], [booked,'Tours booked'], [esc,'Escalations'],\n    [refused,'Refused to guess'], [pricedOut.length,'Priced out'],\n    [avgGap!==null?money(avgGap):'—','Avg gap'],\n  ].map(([n,l])=>`<div class=\"tile\"><div class=\"n\">${n}</div><div class=\"l\">${l}</div></div>`).join('')\n\n  const el = document.getElementById('calls')\n  if(calls.length===0){\n    el.innerHTML = `<div class=\"empty\"><strong>No calls yet</strong>\n      Call <a class=\"tel\" href=\"tel:+15169909252\">(516) 990-9252</a> and this fills in as it happens.</div>`\n    return\n  }\n\n  el.innerHTML = calls.reverse().map(id=>{\n    const rows = byCall[id].map(e=>{\n      const d = describe(e)\n      const t = new Date(e.at).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit'})\n      return `<div class=\"ev\"><div class=\"t\">${t}</div><div>\n        <span class=\"k ${KIND_STYLE[e.kind]||''}\">${LABEL[e.kind]||e.kind}</span>\n        <div class=\"body\">${escapeHtml(d.body||'')}</div>\n        ${d.excerpt?`<div class=\"ex\">\"${escapeHtml(d.excerpt)}\"</div>`:''}\n        ${d.meta?`<div class=\"meta\">${escapeHtml(d.meta)}</div>`:''}\n      </div></div>`\n    }).join('')\n    return `<div class=\"call\"><div class=\"call-h\">\n      <span class=\"call-id\">${escapeHtml(id)}</span>\n      <span class=\"call-id\">${byCall[id].length} events</span>\n    </div>${rows}</div>`\n  }).join('')\n}\n\nfunction escapeHtml(s){\n  return String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]))\n}\n\n/**\n * The log endpoint is gated by the same operations session that served this page, so the\n * poll sends the session cookie and treats a 401 as \"the session ended\", not as a blip. A\n * dashboard that keeps retrying a closed door looks broken; sending the operator back to\n * the gate is honest and takes one click to fix.\n */\nlet timer = null\nfunction stopPolling(){ if(timer !== null){ clearInterval(timer); timer = null } }\nfunction toGate(){ stopPolling(); location.assign('/api/dashboard') }\n\nasync function tick(){\n  try{\n    const r = await fetch('/api/vapi', {\n      cache:'no-store', credentials:'same-origin', headers:{accept:'application/json'},\n    })\n    if(r.status === 401 || r.status === 403){ toGate(); return }\n    if(!r.ok) throw new Error('HTTP ' + r.status)\n    const d = await r.json()\n    render(d)\n    document.getElementById('status').textContent =\n      'Live · updated ' + new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})\n    document.getElementById('note').textContent = d.note || ''\n  }catch(err){\n    document.getElementById('status').textContent = 'Reconnecting…'\n  }\n}\n\ndocument.getElementById('signout').addEventListener('click', async () => {\n  stopPolling()\n  try{\n    await fetch('/api/dashboard', {\n      method:'POST', credentials:'same-origin',\n      headers:{'content-type':'application/json'}, body:JSON.stringify({action:'logout'}),\n    })\n  }catch(err){ /* the cookie expires on its own; go back to the gate regardless */ }\n  location.assign('/api/dashboard')\n})\n\ntick(); timer = setInterval(tick, 5000)\n</script>\n</body>\n</html>\n"
}
