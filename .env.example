# Copy to .env and fill in. .env is gitignored and must never be committed.
# In production these are set in the host's environment variable store
# (Vercel/Railway/Fly project settings), not in a file.

# PostgreSQL runtime — configure once per deployment, never once per staff account.
# Leave this entire block absent for the legacy adapter. To opt in, supply ALL five
# values below. A blank/unknown mode, or either database URL without mode=postgres,
# deliberately refuses requests; it does not fall back to legacy or memory storage.
# ATRIUM_RUNTIME_MODE=postgres
# ATRIUM_DATABASE_URL=postgresql://atrium_app:<percent-encoded-password>@<database-host>:5432/<database-name>
# ATRIUM_AUTH_DATABASE_URL=postgresql://atrium_authenticator:<percent-encoded-password>@<database-host>:5432/<database-name>
# OPS_SESSION_SECRET=<independent-random-secret-at-least-32-characters>
# ATRIUM_AUTH_ORIGIN=https://portal.example.com
# Set the exact HTTPS portal origin for passkeys, without a path or trailing slash.
# Local development may use http://localhost:4300. Request headers cannot choose it.
# Optional PEM CA certificate for the database's verified TLS chain:
# ATRIUM_DATABASE_CA=<PEM-CA-certificate>
# URLs must not contain query parameters or fragments. Nonlocal connections require
# certificate verification. Never put an admin/database-owner URL in either value.
# Provision users, password hashes, organizations, memberships, grants, channel
# bindings and published property bundles in PostgreSQL. OPS_ACCOUNTS_JSON and the
# shared passcode below do not supply users in postgres mode. See db/README.md.

# Vapi API key — server-side only, never exposed to a browser.
# VAPI_API_KEY is accepted as an alias.
VAPI_PRIVATE_KEY=

# Shared secret for verifying inbound Vapi webhooks are genuine.
VAPI_WEBHOOK_SECRET=
# Vapi custom credential that sends the same secret in X-Vapi-Secret (no Bearer prefix),
# or Authorization with Bearer. Required for the coordinated assistant publisher.
VAPI_WEBHOOK_CREDENTIAL_ID=

# Model provider for the conversation engine.
ANTHROPIC_API_KEY=

# Legacy single-workspace passcode. Named accounts below supersede this entirely.
# Passcode staff type to open the operations dashboard at /api/dashboard, and the
# credential the dashboard's log endpoint checks. The log holds every caller's name,
# email, budget ceiling and verbatim excerpts, so without this set the dashboard and
# the log both stay closed — they do not fall back to open. Invent a long random
# string; DASHBOARD_TOKEN is accepted as an alias for the same value.
OPS_DASHBOARD_PASSCODE=

# Durable shared state (Redis/Upstash REST). Both values are required.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Pin the assistant when the Vapi account has more than one.
VAPI_ASSISTANT_ID=

# Named accounts: set BOTH variables in the server environment. Omit OPS_ACCOUNTS_JSON
# entirely for legacy mode; a present but blank/invalid value deliberately fails closed.
# OPS_SESSION_SECRET=<independent random secret, at least 32 characters>
# OPS_ACCOUNTS_JSON=[{"username":"operator","passwordHash":"<scrypt hash>","tenantId":"client-one","displayName":"Client One","assistantIds":[]}]
# See TENANCY.md for provisioning. Never put raw passwords in OPS_ACCOUNTS_JSON.

# Canonical HTTPS origin used when publishing the assistant; no path or trailing slash.
VAPI_SERVER_BASE_URL=
# In named mode, pin the tenant whose property config is currently bundled in this deploy.
VAPI_SYNC_TENANT_ID=
