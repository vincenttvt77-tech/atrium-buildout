# Copy to .env and fill in. .env is gitignored and must never be committed.
# In production these are set in the host's environment variable store
# (Vercel/Railway/Fly project settings), not in a file.

# Vapi API key — server-side only, never exposed to a browser.
VAPI_PRIVATE_KEY=

# Shared secret for verifying inbound Vapi webhooks are genuine.
VAPI_WEBHOOK_SECRET=

# Model provider for the conversation engine.
ANTHROPIC_API_KEY=

# Gates the operations dashboard. Without it the dashboard is readable by anyone
# with the URL — including every caller's name, email, budget and transcript.
# The page shows a warning banner until this is set.
DASHBOARD_TOKEN=
