{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "referrer-policy",
          "value": "no-referrer"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
